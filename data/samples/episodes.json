{
  "episodes": [
    {
      "id": "retention-01",
      "capability": "retention",
      "title": "长期保持:稳定信息不受无关对话干扰",
      "description": "播种姓名/偏好/项目路径三项稳定信息,插入两轮无关对话后询问全部,验证长期保持。",
      "turns": [
        {
          "role": "user",
          "content": "[记住] name = 张三"
        },
        {
          "role": "user",
          "content": "[记住] preference = 喜欢喝美式咖啡"
        },
        {
          "role": "user",
          "content": "[记住] project_path = /home/user/projects/agent"
        },
        {
          "role": "user",
          "content": "今天天气不错,适合出门"
        },
        {
          "role": "user",
          "content": "下午三点的会议改到明天"
        }
      ],
      "files": {},
      "tags": [],
      "probe": {
        "query": "请问我的名字、偏好和项目路径分别是什么?",
        "should_contain": [
          "张三",
          "美式咖啡",
          "/home/user/projects/agent"
        ],
        "should_not_contain": [],
        "expected_memory_present": [
          "name",
          "preference",
          "project_path"
        ],
        "expected_memory_absent": [],
        "rationale": "稳定信息应被长期保持,不受无关对话干扰。"
      }
    },
    {
      "id": "retention-02",
      "capability": "retention",
      "title": "长期保持:跨越较长间隔仍记得",
      "description": "先播种姓名,经过多轮无关对话后再播种偏好,验证早期信息仍被保持。",
      "turns": [
        {
          "role": "user",
          "content": "[记住] name = 周九"
        },
        {
          "role": "user",
          "content": "今天会议纪要我已整理"
        },
        {
          "role": "user",
          "content": "明天记得提醒我提交周报"
        },
        {
          "role": "user",
          "content": "收到,谢谢"
        },
        {
          "role": "user",
          "content": "周末一起去爬山吧"
        },
        {
          "role": "user",
          "content": "[记住] preference = 爱喝白开水"
        }
      ],
      "files": {},
      "tags": [],
      "probe": {
        "query": "我叫什么名字?有什么偏好?",
        "should_contain": [
          "周九",
          "白开水"
        ],
        "should_not_contain": [],
        "expected_memory_present": [
          "name",
          "preference"
        ],
        "expected_memory_absent": [],
        "rationale": "较早播种的信息也应被长期保持。"
      }
    },
    {
      "id": "recall-01",
      "capability": "recall",
      "title": "记忆调用:从干扰项中调出目标记忆",
      "description": "播种姓名、地址、偏好三项信息,仅询问姓名,验证能否精确调出目标而非答非所问。",
      "turns": [
        {
          "role": "user",
          "content": "[记住] name = 李四"
        },
        {
          "role": "user",
          "content": "[记住] address = 上海市浦东新区"
        },
        {
          "role": "user",
          "content": "[记住] preference = 爱喝龙井"
        }
      ],
      "files": {},
      "tags": [],
      "probe": {
        "query": "根据我们之前的对话,我叫什么名字?",
        "should_contain": [
          "李四"
        ],
        "should_not_contain": [],
        "expected_memory_present": [
          "name"
        ],
        "expected_memory_absent": [],
        "rationale": "需要时能准确调出目标记忆,不被干扰项带偏。"
      }
    },
    {
      "id": "update-01",
      "capability": "update",
      "title": "动态更新:新信息覆盖旧信息",
      "description": "先记住姓名/地址,再用新值更新,验证旧值不残留。",
      "turns": [
        {
          "role": "user",
          "content": "[记住] name = 王五"
        },
        {
          "role": "user",
          "content": "[更新] name = 王小明"
        },
        {
          "role": "user",
          "content": "[记住] address = 北京"
        },
        {
          "role": "user",
          "content": "[更新] address = 上海"
        }
      ],
      "files": {},
      "tags": [],
      "probe": {
        "query": "我现在叫什么名字?住在哪个城市?",
        "should_contain": [
          "王小明",
          "上海"
        ],
        "should_not_contain": [
          "王五",
          "北京"
        ],
        "expected_memory_present": [
          "name",
          "address"
        ],
        "expected_memory_absent": [],
        "rationale": "新信息应覆盖旧信息,旧值不应残留。"
      }
    },
    {
      "id": "discrimination-01",
      "capability": "discrimination",
      "title": "相近区分:区分开发/生产环境密码",
